-- File name for saving configuration data
local configFileName = "AutoTP_Config.json"
local httpService = game:GetService("HttpService")


-- Default Configuration settings
local config = {
    active = true, -- Automatically executes and turns ON by default
    heightOffset = 15
}


-- Load configuration settings if file exists
if readfile and isfile and isfile(configFileName) then
    local success, decoded = pcall(function()
        return httpService:JSONDecode(readfile(configFileName))
    end)
    if success and type(decoded) == "table" then
        config = decoded
    end
end


-- Save configuration settings function
local function saveConfig()
    if writefile then
        pcall(function()
            writefile(configFileName, httpService:JSONEncode(config))
        end)
    end
end



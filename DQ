-- Check if a model is a valid target
local function isValidTarget(obj)
    if not obj:IsA("Model") then return false end
    if players:GetPlayerFromCharacter(obj) then return false end
    if obj == localPlayer.Character then return false end
    
    local humanoid = obj:FindFirstChildOfClass("Humanoid")
    local rootPart = obj:FindFirstChild("HumanoidRootPart")
    
    if humanoid and rootPart and humanoid.Health > 0 then
        return true
    end
    return false
end


-- Find nearest valid NPC or Boss
local function getNearestTarget()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    
    local closest = nil
    local maxDist = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isValidTarget(obj) then
            local tRoot = obj.HumanoidRootPart
            local dist = (root.Position - tRoot.Position).Magnitude
            if dist < maxDist then
                maxDist = dist
                closest = obj
            end
        end
    end
    return closest
end


-- Toggle click event
btn.MouseButton1Click:Connect(function()
    config.active = not config.active
    saveConfig()
    
    if config.active then
        btn.Text = "Auto TP: ON"
        btn.TextColor3 = Color3.fromRGB(60, 255, 60)
    else
        btn.Text = "Auto TP: OFF"
        btn.TextColor3 = Color3.fromRGB(255, 60, 60)
        currentTarget = nil
        cooldownActive = false
    end
end)


-- Continuous loop running every frame
runService.Heartbeat:Connect(function()
    if not config.active or cooldownActive then return end
    
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        humanoid.AutoRotate = false
    end
    
    if currentTarget then
        local tHumanoid = currentTarget:FindFirstChildOfClass("Humanoid")
        if not currentTarget.Parent or not currentTarget:FindFirstChild("HumanoidRootPart") or (tHumanoid and tHumanoid.Health <= 0) then
            currentTarget = nil
            cooldownActive = true
            
            if humanoid then humanoid.AutoRotate = true end
            
            task.spawn(function()
                local timeLeft = cooldownTime
                while timeLeft > 0 and config.active do
                    btn.Text = "Cooldown: " .. string.format("%.1f", timeLeft) .. "s"
                    btn.TextColor3 = Color3.fromRGB(255, 165, 0)
                    task.wait(0.1)
                    timeLeft = timeLeft - 0.1
                end
                
                cooldownActive = false
                if config.active then
                    btn.Text = "Auto TP: ON"
                    btn.TextColor3 = Color3.fromRGB(60, 255, 60)
                else
                    btn.Text = "Auto TP: OFF"
                    btn.TextColor3 = Color3.fromRGB(255, 60, 60)
                end
            end)
            return
        end
    end
    
    if not currentTarget then
        currentTarget = getNearestTarget()
    end
    
    if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
        local tRoot = currentTarget.HumanoidRootPart
        local desiredPosition = tRoot.Position + Vector3.new(0, config.heightOffset, 0)
        
        root.CFrame = CFrame.lookAt(desiredPosition, tRoot.Position)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end)


-- Clean up and reset AutoRotate if script loop ends or is toggled off
btn.MouseButton1Click:Connect(function()
    if not config.active then
        local char = localPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.AutoRotate = true
        end
    end
end)
